# Copy to .env, set seven distinct local passwords, and keep .env out of Git.
# Compose rejects empty values; these placeholders are not usable credentials.
POSTGRES_PASSWORD=
EXTRACTOR_MIGRATOR_PASSWORD=
EXTRACTOR_RUNTIME_PASSWORD=
TRANSFORMER_MIGRATOR_PASSWORD=
TRANSFORMER_RUNTIME_PASSWORD=
LOADER_MIGRATOR_PASSWORD=
LOADER_RUNTIME_PASSWORD=
# Host access is bound to loopback only.
POSTGRES_PORT=5432

# Optional Stage 13.2B live smoke only; never used by services or CI.
# Keep disabled until separately authorized. No real URL belongs in this file.
ETHEREUM_LIVE_MAINNET_OPT_IN=false
# Set privately to https://mainnet.infura.io/v3/<YOUR-API-KEY>. Never log this URL.
ETHEREUM_RPC_URL=
# Explicit decimal, mined Mainnet block number; no implicit latest/head selection.
ETHEREUM_SMOKE_BLOCK=

# Both required: 1–100 actual RPC attempts and 1ms–2m RPC-operation deadline.
ETHEREUM_SMOKE_MAX_REQUESTS=
ETHEREUM_SMOKE_TIMEOUT=

# Stage 13.3A prepares capture only; enable only for separately authorized capture.
# Reuses private ETHEREUM_RPC_URL. Select a pinned manifest case, never latest.
ETHEREUM_CAPTURE_OPT_IN=false
# Required: at least transaction_count + 3 and at most 1000 actual attempts.
ETHEREUM_CAPTURE_MAX_REQUESTS=
# Required: 1ms–2m; ordinary tests and CI never enable capture.
ETHEREUM_CAPTURE_TIMEOUT=

# Finite index/reindex waits for durable Outbox delivery (1ms..2m).
EXTRACTOR_DRAIN_TIMEOUT=30s

# Stage 14.2: bounded admission (see docs/architecture/backpressure-stage14.md).
TRANSFORMER_MAX_OUTSTANDING_EVENTS=128
LOADER_MAX_OUTSTANDING_EVENTS=128
TRANSFORMER_MAX_INCOMING_REQUESTS=2
LOADER_MAX_INCOMING_REQUESTS=2
TRANSFORMER_MAX_INFLIGHT_BYTES=136314880
LOADER_MAX_INFLIGHT_BYTES=136314880
TRANSFORMER_MAX_GRPC_CONNECTIONS=16
LOADER_MAX_GRPC_CONNECTIONS=16
EXTRACTOR_DB_MAX_CONNECTIONS=12
TRANSFORMER_DB_MAX_CONNECTIONS=12
LOADER_DB_MAX_CONNECTIONS=12
# Compose defaults: PostgreSQL 2 CPUs/2g, each Go service 1 CPU/2g.
# Override *_CPUS, *_MEM_LIMIT and *_GO_MEMORY_LIMIT (default 1536MiB).

# Stage 14.3: receipts within one block; heights remain sequential (range 1..8).
EXTRACTOR_RECEIPT_CONCURRENCY=1

# Loader SQL statements per batch (1 = direct Exec reference, maximum 256).
LOADER_SQL_BATCH_SIZE=64
