# Copy to .env, set seven distinct local passwords, and keep .env out of Git.
# Compose rejects empty values; these placeholders are not usable credentials.
POSTGRES_PASSWORD=
EXTRACTOR_MIGRATOR_PASSWORD=
EXTRACTOR_RUNTIME_PASSWORD=
TRANSFORMER_MIGRATOR_PASSWORD=
TRANSFORMER_RUNTIME_PASSWORD=
LOADER_MIGRATOR_PASSWORD=
LOADER_RUNTIME_PASSWORD=
# Host access is bound to loopback only.
POSTGRES_PORT=5432
